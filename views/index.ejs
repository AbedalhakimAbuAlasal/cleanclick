  a.textContent = masked;
document.addEventListener('DOMContentLoaded', () => {
  const container = document.getElementById('cards-container');
  const dotsContainer = document.getElementById('cards-dots');
  const cards = Array.from(container.children);

  if (!container || window.innerWidth >= 768) return; 

  cards.forEach((_, index) => {
    const dot = document.createElement('div');
    dot.className = 'w-3 h-3 rounded-full bg-gray-400 transition-all duration-300 cursor-pointer';
    dot.addEventListener('click', () => {
      container.scrollTo({ left: cards[index].offsetLeft, behavior: 'smooth' });
    });
    dotsContainer.appendChild(dot);
  });

  const updateDots = () => {
    const scrollLeft = container.scrollLeft;
    const cardWidth = cards[0].offsetWidth + 32; 
    const activeIndex = Math.round(scrollLeft / cardWidth);
    dotsContainer.querySelectorAll('div').forEach((dot, idx) => {
      dot.classList.toggle('bg-[#4DD6C6]', idx === activeIndex);
      dot.classList.toggle('bg-gray-400', idx !== activeIndex);
    });
  };

  updateDots();
  container.addEventListener('scroll', updateDots);
});

