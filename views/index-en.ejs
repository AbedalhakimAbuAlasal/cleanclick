<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crystal | Professional Tank Cleaning</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; scroll-behavior: smooth; }
        .brand-gradient { background: linear-gradient(135deg, #2cb1bc 0%, #25949d 100%); }
        .text-brand { color: #2cb1bc; }
        .btn-active { border-color: #2cb1bc !important; background-color: #f0fdfa; color: #2cb1bc; }
        .card-shadow { box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05); }
        
        /* تأثيرات إضافية للتفاعل */
        .option-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .option-card:hover { transform: translateY(-2px); border-color: #2cb1bc; }
    </style>
</head>
<body class="bg-[#fcfdfd] text-gray-800">

    <nav class="bg-white/80 backdrop-blur-md sticky top-0 z-[100] border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                <div class="flex items-center gap-2 group cursor-pointer">
                    <div class="w-11 h-11 brand-gradient rounded-xl flex items-center justify-center text-white shadow-lg shadow-teal-200/50 rotate-3 group-hover:rotate-0 transition-transform">
                        <span class="text-xl font-bold">C</span>
                    </div>
                    <span class="text-2xl font-extrabold tracking-tight text-slate-800">Crystal<span class="text-brand">ly</span></span>
                </div>
                <div class="hidden md:flex items-center gap-8">
                    <a href="#services" class="font-semibold text-sm text-slate-600 hover:text-brand transition">Services</a>
                    <a href="#pricing" class="font-semibold text-sm text-slate-600 hover:text-brand transition">Pricing</a>
                    <a href="#booking" class="brand-gradient text-white px-6 py-3 rounded-full text-sm font-bold shadow-md hover:scale-105 transition active:scale-95">Book Appointment</a>
                </div>
            </div>
        </div>
    </nav>

    <section class="relative overflow-hidden pt-16 pb-20 lg:pt-24 lg:pb-32">
        <div class="max-w-7xl mx-auto px-4 relative z-10">
            <div class="text-center max-w-4xl mx-auto">
                <span class="inline-block px-4 py-1.5 rounded-full bg-teal-50 text-brand text-xs font-bold tracking-widest uppercase mb-6">Certified Water Specialists in Amman</span>
                <h1 class="text-5xl lg:text-7xl font-extrabold text-slate-900 mb-8 tracking-tight">
                    Pure Water for a <span class="text-brand">Healthier Home.</span>
                </h1>
                <p class="text-lg text-slate-500 mb-10 leading-relaxed max-w-2xl mx-auto">
                    Professional tank and well cleaning using medical-grade disinfection. Trusted by 2,000+ villas and companies in Amman.
                </p>
                
                <div class="bg-white p-2 rounded-2xl shadow-2xl border border-gray-100 flex flex-col md:flex-row gap-2 max-w-2xl mx-auto">
                    <div class="flex-1 flex items-center px-4 gap-3">
                        <span class="text-gray-400">📍</span>
                        <input type="text" placeholder="Enter Area (e.g. Abdoun)" class="w-full py-4 text-sm font-medium outline-none">
                    </div>
                    <button onclick="document.getElementById('booking').scrollIntoView()" class="brand-gradient text-white px-10 py-4 rounded-xl font-bold hover:opacity-95 transition shadow-lg">Check Availability</button>
                </div>
            </div>
        </div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-0 opacity-10 pointer-events-none">
            <svg viewBox="0 0 100 100" class="w-full h-full"><circle cx="50" cy="50" r="40" fill="url(#grad1)" /></svg>
            <defs><radialGradient id="grad1"><stop offset="0%" stop-color="#2cb1bc"/><stop offset="100%" stop-color="white"/></radialGradient></defs>
        </div>
    </section>

    <section id="booking" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex flex-col lg:flex-row gap-12">
                
                <div class="flex-1">
                    <div class="mb-10">
                        <h2 class="text-3xl font-bold text-slate-900">Customize Your Service</h2>
                        <p class="text-slate-500 mt-2">Select the details below to see an instant quote.</p>
                    </div>

                    <div class="space-y-12">
                        <div class="step-container">
                            <label class="flex items-center gap-3 text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">
                                <span class="w-8 h-8 rounded-full brand-gradient text-white flex items-center justify-center text-xs">01</span>
                                Select Service Type
                            </label>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                                <div onclick="selectService('Standard', 20)" id="service-Standard" class="option-card cursor-pointer p-6 border-2 border-gray-100 rounded-2xl hover:bg-gray-50 relative group btn-active">
                                    <h4 class="font-bold text-lg">Standard</h4>
                                    <p class="text-xs text-gray-500 mt-1">Roof tank disinfection</p>
                                    <div class="absolute top-4 right-4 text-brand opacity-0 group-[.btn-active]:opacity-100">✓</div>
                                </div>
                                <div onclick="selectService('Deep', 35)" id="service-Deep" class="option-card cursor-pointer p-6 border-2 border-gray-100 rounded-2xl hover:bg-gray-50 relative group">
                                    <h4 class="font-bold text-lg">Deep Clean</h4>
                                    <p class="text-xs text-gray-500 mt-1">Walls & floor scrubbing</p>
                                    <div class="absolute top-4 right-4 text-brand opacity-0 group-[.btn-active]:opacity-100">✓</div>
                                </div>
                                <div onclick="selectService('Well', 50)" id="service-Well" class="option-card cursor-pointer p-6 border-2 border-gray-100 rounded-2xl hover:bg-gray-50 relative group">
                                    <h4 class="font-bold text-lg">Ground Well</h4>
                                    <p class="text-xs text-gray-500 mt-1">Sediment removal</p>
                                    <div class="absolute top-4 right-4 text-brand opacity-0 group-[.btn-active]:opacity-100">✓</div>
                                </div>
                            </div>
                        </div>

                        <div class="step-container">
                            <label class="flex items-center gap-3 text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">
                                <span class="w-8 h-8 rounded-full brand-gradient text-white flex items-center justify-center text-xs">02</span>
                                Quantity & Units
                            </label>
                            <div class="grid sm:grid-cols-2 gap-6">
                                <div class="p-6 bg-slate-50 rounded-2xl flex items-center justify-between">
                                    <div>
                                        <span class="block font-bold">Roof Tanks</span>
                                        <span class="text-xs text-slate-400">8 JOD per additional</span>
                                    </div>
                                    <div class="flex items-center gap-4 bg-white p-2 rounded-xl shadow-sm">
                                        <button onclick="updateQty('tanks', -1)" class="w-10 h-10 rounded-lg hover:bg-gray-100 font-bold">-</button>
                                        <span id="qty-tanks" class="w-6 text-center font-bold">1</span>
                                        <button onclick="updateQty('tanks', 1)" class="w-10 h-10 rounded-lg hover:bg-gray-100 font-bold text-brand">+</button>
                                    </div>
                                </div>
                                <div class="p-6 bg-slate-50 rounded-2xl flex items-center justify-between">
                                    <div>
                                        <span class="block font-bold">Well Depth</span>
                                        <span class="text-xs text-slate-400">Per 5 meters</span>
                                    </div>
                                    <div class="flex items-center gap-4 bg-white p-2 rounded-xl shadow-sm">
                                        <button onclick="updateQty('wells', -1)" class="w-10 h-10 rounded-lg hover:bg-gray-100 font-bold">-</button>
                                        <span id="qty-wells" class="w-6 text-center font-bold">0</span>
                                        <button onclick="updateQty('wells', 1)" class="w-10 h-10 rounded-lg hover:bg-gray-100 font-bold text-brand">+</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="lg:w-[400px]">
                    <div class="bg-white rounded-3xl border border-gray-100 shadow-2xl p-8 sticky top-28">
                        <div class="flex justify-between items-center mb-8">
                            <h3 class="font-extrabold text-xl">Order Summary</h3>
                            <span class="px-3 py-1 bg-orange-100 text-orange-600 rounded-full text-[10px] font-bold uppercase">Same Day</span>
                        </div>
                        
                        <div class="space-y-4 mb-8">
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-500">Service: <span id="summary-service-name" class="text-slate-900 font-semibold">Standard</span></span>
                                <span id="summary-service-price" class="font-bold">20 JOD</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-500">Additional Tanks (<span id="summary-tanks-qty">0</span>)</span>
                                <span id="summary-tanks-price" class="font-bold">0 JOD</span>
                            </div>
                            <div class="flex justify-between text-sm border-t border-dashed pt-4">
                                <span class="text-slate-500 font-bold">VAT (16%)</span>
                                <span id="summary-tax" class="font-bold">3.2 JOD</span>
                            </div>
                        </div>

                        <div class="bg-slate-900 rounded-2xl p-6 text-white mb-6">
                            <span class="text-xs opacity-60 uppercase tracking-widest font-bold">Estimated Total</span>
                            <div class="flex items-baseline gap-1">
                                <span class="text-4xl font-extrabold" id="total-price">23.2</span>
                                <span class="text-lg font-bold">JOD</span>
                            </div>
                        </div>

                        <button class="w-full brand-gradient text-white py-5 rounded-2xl font-bold text-lg shadow-lg shadow-teal-200 hover:scale-[1.02] transition active:scale-95 flex items-center justify-center gap-3">
                            Confirm Booking
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </button>
                        
                        <div class="mt-6 flex items-center justify-center gap-4 text-[10px] text-slate-400 font-bold uppercase tracking-tighter">
                            <span>No Prepayment Required</span>
                            <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
                            <span>Cancel Anytime</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <footer class="bg-slate-900 text-white pt-20 pb-10">
        <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-12 border-b border-slate-800 pb-16">
            <div class="col-span-1 md:col-span-1">
                <div class="flex items-center gap-2 mb-6">
                    <div class="w-8 h-8 brand-gradient rounded-lg flex items-center justify-center text-white font-bold">C</div>
                    <span class="text-xl font-bold">Crystal Clean</span>
                </div>
                <p class="text-slate-400 text-sm leading-relaxed mb-6">The leading provider of hygiene solutions for water storage systems in Jordan since 2015.</p>
                <div class="flex gap-4">
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-brand transition">f</a>
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-brand transition">in</a>
                </div>
            </div>
            <div>
                <h4 class="font-bold mb-6">Services</h4>
                <ul class="text-slate-400 text-sm space-y-4">
                    <li><a href="#" class="hover:text-white transition">Residential Cleaning</a></li>
                    <li><a href="#" class="hover:text-white transition">Commercial Maintenance</a></li>
                    <li><a href="#" class="hover:text-white transition">Water Quality Testing</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-6">Company</h4>
                <ul class="text-slate-400 text-sm space-y-4">
                    <li><a href="#" class="hover:text-white transition">About Our Tech</a></li>
                    <li><a href="#" class="hover:text-white transition">Safety Protocols</a></li>
                    <li><a href="#" class="hover:text-white transition">Contact Us</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-6">Office</h4>
                <p class="text-slate-400 text-sm mb-2">Amman, Mecca St. Building 42</p>
                <p class="text-brand font-bold">079 000 0000</p>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 mt-10 text-center text-slate-500 text-xs">
            © 2026 Crystally Maintenance Systems. Licensed by Amman Municipality.
        </div>
    </footer>

    <script>
        let state = {
            service: 'Standard',
            basePrice: 20,
            tanks: 1,
            wells: 0
        };

        function selectService(name, price) {
            state.service = name;
            state.basePrice = price;
            
            // UI Update
            document.querySelectorAll('.option-card').forEach(card => card.classList.remove('btn-active'));
            document.getElementById('service-' + name).classList.add('btn-active');
            
            calculate();
        }

        function updateQty(type, change) {
            state[type] = Math.max(type === 'tanks' ? 1 : 0, state[type] + change);
            document.getElementById('qty-' + type).innerText = state[type];
            calculate();
        }

        function calculate() {
            // Price calculation logic
            const addTanksPrice = (state.tanks - 1) * 8;
            const addWellsPrice = state.wells * 15;
            const subtotal = state.basePrice + addTanksPrice + addWellsPrice;
            const tax = subtotal * 0.16;
            const total = subtotal + tax;

            // Update UI
            document.getElementById('summary-service-name').innerText = state.service;
            document.getElementById('summary-service-price').innerText = state.basePrice + ' JOD';
            document.getElementById('summary-tanks-qty').innerText = state.tanks - 1;
            document.getElementById('summary-tanks-price').innerText = addTanksPrice + ' JOD';
            document.getElementById('summary-tax').innerText = tax.toFixed(1) + ' JOD';
            document.getElementById('total-price').innerText = total.toFixed(1);
        }
    </script>

</body>
</html>