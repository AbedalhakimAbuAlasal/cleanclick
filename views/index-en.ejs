    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const serviceButtons = document.querySelectorAll('[data-service]');
            const roofCountEl = document.querySelector('#roof-count');
            const wellCountEl = document.querySelector('#well-count');
            const totalCostEl = document.querySelector('#total-cost');
            const serviceNameEl = document.querySelector('#summary-service');
            const itemsList = document.querySelector('#summary-items');

            let state = { service: 'STANDARD', roof: 1, well: 0 };
            const servicePrices = { STANDARD: 28, DEEP: 50, WELLS: 45, COMMERCIAL: 75 };

            function updateSummary() {
                // Update Summary Text
                serviceNameEl.textContent = state.service + ' Cleaning';
                let itemsText = [];
                if(state.roof > 0) itemsText.push(`Roof Tanks: ${state.roof}`);
                if(state.well > 0) itemsText.push(`Ground Wells: ${state.well}`);
                itemsList.innerHTML = itemsText.join(' | ');

                // Calc Total
                let total = (state.roof + state.well) * servicePrices[state.service];
                
                // Animate Price change
                totalCostEl.textContent = total;
                
                // Highlight active button
                serviceButtons.forEach(btn => {
                    if(btn.dataset.service === state.service) {
                        btn.classList.add('active-service');
                    } else {
                        btn.classList.remove('active-service');
                    }
                });
            }

            serviceButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    state.service = btn.dataset.service;
                    updateSummary();
                });
            });

            document.querySelector('#roof-plus').addEventListener('click', () => { state.roof++; roofCountEl.textContent = state.roof; updateSummary(); });
            document.querySelector('#roof-minus').addEventListener('click', () => { if(state.roof > 0){ state.roof--; roofCountEl.textContent = state.roof; updateSummary(); } });
            document.querySelector('#well-plus').addEventListener('click', () => { state.well++; wellCountEl.textContent = state.well; updateSummary(); });
            document.querySelector('#well-minus').addEventListener('click', () => { if(state.well > 0){ state.well--; wellCountEl.textContent = state.well; updateSummary(); } });

            // Init
            updateSummary();
        });
    </script>
